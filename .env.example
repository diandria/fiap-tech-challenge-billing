PORT=3001
LOG_LEVEL=info
# Must be the same secret the OS Service and the authentication function use:
# both staff and customer tokens are validated here.
JWT_SECRET=change-me-in-production-use-a-long-random-string

DATABASE_URL="postgresql://billing:billing@localhost:5433/billing?schema=public"

# Without OTEL_EXPORTER_OTLP_ENDPOINT the tracing SDK stays off.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=billing-service
SERVICE_VERSION=0.0.0

CORS_ORIGIN=http://localhost:3001
TRUST_PROXY_HOPS=0

# Saga queues. With neither set the service runs without messaging; with only
# one set it refuses to start.
# QUEUE_URL_BILLING_COMMANDS=http://localhost:4567/000000000000/car-repair-shop-billing-commands.fifo
# QUEUE_URL_SAGA_REPLIES=http://localhost:4567/000000000000/car-repair-shop-saga-replies.fifo
AWS_REGION=us-east-1
# Local only, to point the AWS SDK at LocalStack.
# AWS_ENDPOINT_URL=http://localhost:4567

# Mercado Pago. The credentials are exchanged for a short-lived token
# (client_credentials); the notification url is the public webhook route.
# With none set there is no payment provider; with only part set the service
# refuses to start.
# MERCADO_PAGO_CLIENT_ID=
# MERCADO_PAGO_CLIENT_SECRET=
# MERCADO_PAGO_NOTIFICATION_URL=https://<api-gateway>/payments/webhook
