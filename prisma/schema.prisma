// Billing data only. No table here is read by another service, and this
// service reads no table of another (ADR-016 in the OS Service repository).

generator client {
  provider        = "prisma-client-js"
  // Required for Prisma to emit spans: it talks to its own query engine rather
  // than the pg driver, so pg instrumentation sees nothing.
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Messages waiting to be published, written in the same transaction as the
// change that produced them. The relay publishes and marks them.
model OutboxMessage {
  id             String    @id @db.Uuid
  destination    String
  type           String
  serviceOrderId String    @map("service_order_id") @db.Uuid
  payload        Json
  traceparent    String?
  createdAt      DateTime  @default(now()) @map("created_at")
  publishedAt    DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_messages")
}

// Ids of messages already handled. Recording the id in the same transaction as
// the effect makes a redelivered message produce no effect the second time.
model ProcessedMessage {
  messageId   String   @id @map("message_id") @db.Uuid
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_messages")
}

enum BudgetStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum BudgetLineKind {
  SERVICE
  ITEM
}

// One budget per service order. Customer contact and prices are copies of what
// the OS Service sent: this service never reads the OS database.
model Budget {
  id             String       @id @default(uuid()) @db.Uuid
  serviceOrderId String       @unique @map("service_order_id") @db.Uuid
  customerId     String       @map("customer_id") @db.Uuid
  customerName   String       @map("customer_name")
  customerEmail  String       @map("customer_email")
  total          Decimal      @db.Decimal(10, 2)
  status         BudgetStatus @default(PENDING_APPROVAL)
  version        Int          @default(0)
  decidedAt      DateTime?    @map("decided_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  lines          BudgetLine[]

  @@map("budgets")
}

model BudgetLine {
  id          String         @id @default(uuid()) @db.Uuid
  budgetId    String         @map("budget_id") @db.Uuid
  kind        BudgetLineKind
  referenceId String         @map("reference_id") @db.Uuid
  description String
  unitPrice   Decimal        @map("unit_price") @db.Decimal(10, 2)
  quantity    Int
  budget      Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@map("budget_lines")
}
